rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // Read the user's Firestore profile (orgId lives here, not in the token)
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userOrgId() {
      return userDoc().orgId;
    }

    function getUserRole() {
      return userDoc().role;
    }

    function isOrgMember(resourceOrgId) {
      return isSignedIn() && userOrgId() == resourceOrgId;
    }

    function isAdmin() {
      return isSignedIn() && getUserRole() == 'admin';
    }

    function isAdminOrManager() {
      return isSignedIn() && getUserRole() in ['admin', 'manager'];
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Users can read their own doc; admins can read all in their org
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        (isAdmin() && resource.data.orgId == userOrgId())
      );
      // Anyone signed in can create/update their own profile
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      // Admins can update other users in same org
      allow update: if isAdmin() && resource.data.orgId == userOrgId();
      allow delete: if false;
    }

    // ── Categories ────────────────────────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isAdminOrManager() && request.resource.data.orgId == userOrgId();
      allow update, delete: if isAdminOrManager() && isOrgMember(resource.data.orgId);
    }

    // ── Devices ───────────────────────────────────────────────────────────────
    match /devices/{deviceId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isAdminOrManager() && request.resource.data.orgId == userOrgId();
      allow update: if isSignedIn() && isOrgMember(resource.data.orgId) && (
        isAdminOrManager() ||
        // Scanners can only update status
        (getUserRole() == 'user' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
      );
      allow delete: if isAdminOrManager() && isOrgMember(resource.data.orgId);
    }

    // ── Device Activity ───────────────────────────────────────────────────────
    match /deviceActivity/{activityId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isSignedIn() && request.resource.data.orgId == userOrgId();
      allow update, delete: if false;
    }

    // ── Custom Fields ─────────────────────────────────────────────────────────
    match /customFields/{orgId} {
      allow read: if isSignedIn() && orgId == userOrgId();
      allow write: if isAdminOrManager() && orgId == userOrgId();
    }

    // ── Maintenance Logs ──────────────────────────────────────────────────────
    match /maintenanceLogs/{logId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isAdminOrManager() && request.resource.data.orgId == userOrgId();
      allow update, delete: if false;
    }

    // ── Reservations ──────────────────────────────────────────────────────────
    match /reservations/{resId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isSignedIn() && request.resource.data.orgId == userOrgId();
      allow delete: if isSignedIn() && isOrgMember(resource.data.orgId) && (
        isAdminOrManager() || resource.data.userId == request.auth.uid
      );
      allow update: if isAdminOrManager() && isOrgMember(resource.data.orgId);
    }

    // ── Vendors ───────────────────────────────────────────────────────────────
    match /vendors/{vendorId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create: if isAdminOrManager() && request.resource.data.orgId == userOrgId();
      allow update, delete: if isAdminOrManager() && isOrgMember(resource.data.orgId);
    }

    // ── Audit Logs ────────────────────────────────────────────────────────────
    match /auditLogs/{auditId} {
      allow read: if isSignedIn() && isOrgMember(resource.data.orgId);
      allow create, update, delete: if false;
    }

    // ── Fallback: deny everything else ────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
